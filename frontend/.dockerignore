# .dockerignore — frontend (context: ./frontend)
# Referência completa na raiz: .dockerignore

# Secrets
.env
.env.*
!.env.example

# Dependências (instaladas dentro do container)
node_modules/

# Build output local (gerado no build do Docker)
dist/
dist-ssr/
*.tsbuildinfo

# Git / IDE
.git/
.gitignore
.dockerignore

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
.cursor/

# Testes / cobrança
coverage/

# Docs
*.md
README.md
