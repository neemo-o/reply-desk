# ═══════════════════════════════════════════════════════════════
# .env — ReplyDesk (raiz do projeto)
# ═══════════════════════════════════════════════════════════════
#
# Este arquivo alimenta as VARIAVEIS DO DOCKER COMPOSE (infra).
# Cada serviço também lê seu próprio .env individual:
#   backend/.env  → variaveis da aplicação (JWT, Stripe, DB URL, etc.)
#   frontend/.env → variaveis do Vite (VITE_API_URL)
#
# As variaveis abaixo controlam portas externas e credenciais da
# infraestrutura (Postgres, Redis, MinIO). O backend/.env tambem
# define essas mesmas chaves; o env_file do compose pega ambos,
# mas o que esta aqui (na raiz) tem precedencia para o compose.
# ═══════════════════════════════════════════════════════════════

# ─── PORTAS EXTERNAS ──────────────────────────────────────────
PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
FRONTEND_PORT=8080

# ─── POSTGRES ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_saas

# ─── MINIO / S3 ────────────────────────────────────────────────
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── EVOLUTION API (WhatsApp externo) ───────────────────────────
# 🔌 Em Docker, o docker-compose já configura estes valores via env.
# Ajuste aqui só se precisar override de dev/prod.
# Token global da Evolution (enviado como header `apikey` pelo backend).
# Deve ser igual ao AUTHENTICATION_API_KEY do serviço evolution-api.
EVOLUTION_API_KEY=replydesk-evolution-token-change-me
# Porta externa para debug local (a Evolution escuta em 8080 interno).
# Mapeada para 127.0.0.1:$EVOLUTION_PORT para inspeção.
EVOLUTION_PORT=8081

# ─── FRONTEND (build-arg do Vite) ─────────────────────────────
# Em Docker, o Nginx faz proxy /api → api:3000, então URL relativa:
VITE_API_URL=/api/v1
