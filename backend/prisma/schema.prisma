generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  avatar        String?
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenantUsers           TenantUser[]
  refreshTokens         RefreshToken[]
  assignedConversations Conversation[]     @relation("AssignedUser")
  conversationNotes     ConversationNote[]
  auditLogs             AuditLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  revoked    Boolean   @default(false)
  // 🔒 S4 — Grace period p/ refresh token rotation.
  // Quando um token é rotacionado, NÃO é revogado imediatamente. Marcamos
  // `replacedAt` e o token continua válido por `JWT_REFRESH_GRACE_MS` (default 30s).
  // Isso permite que múltiplas abas/dispositivos que compartilham o mesmo refresh
  // token façam refresh concorrentemente sem que uma revoke o token da outra.
  // Após o grace, o cleanup job remove; tentativa de uso após grace → 401.
  replacedAt DateTime? @map("replaced_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // DB-7: cron cleanup ORDER BY expires_at
  @@index([userId, revoked, expiresAt]) // DB-7: query ativa do user
  @@index([replacedAt]) // S4: index p/ checar grace period
  @@map("refresh_tokens")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  timezone  String   @default("America/Sao_Paulo")
  language  String   @default("pt-BR")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantUsers    TenantUser[]
  roles          Role[]
  subscriptions  Subscription[]
  sessions       WhatsappSession[]
  sessionEvents  SessionEvent[]
  bots           Bot[]
  contacts       Contact[]
  conversations  Conversation[]
  files          FileAsset[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]
  jobs           Job[]
  auditLogs      AuditLog[]
  dailyMetrics   DailyMetric[]
  knowledgeBases KnowledgeBase[]
  invitations    Invitation[]

  @@map("tenants")
}

model TenantUser {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  roleId   String @map("role_id")
  status   String @default("active")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict) // DB-11: Restrict evita roles sem tenant

  @@unique([tenantId, userId])
  @@index([tenantId]) // DB-1: listagem de membros
  @@index([userId]) // DB-1: tenants do usuário
  @@index([roleId]) // DB-1: lookup por role
  @@map("tenant_users")
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUsers     TenantUser[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId]) // DB-1: lookup de roles por tenant
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Plan {
  id            String  @id @default(uuid())
  name          String
  price         Decimal
  maxSessions   Int     @map("max_sessions")
  maxUsers      Int     @map("max_users")
  maxBots       Int     @map("max_bots")
  maxMessages   Int     @map("max_messages")
  maxStorageMb  Int     @map("max_storage_mb")
  maxAiRequests Int     @map("max_ai_requests")

  // Stripe price IDs — um para pagamento recorrente (mensal automático)
  // e um para pagamento único (avulso). Criados no painel do Stripe.
  stripePriceRecurringId String? @map("stripe_price_recurring_id")
  stripePriceOneTimeId   String? @map("stripe_price_one_time_id")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  planId        String    @map("plan_id")
  status        String    @default("trialing") // trialing | pending | active | past_due | cancelled
  provider      String    @default("stripe")
  externalId    String?   @unique @map("external_id") // Stripe subscription OU checkout session ID
  lastPaymentId String?   @map("last_payment_id")
  // "recurring" = assinatura recorrente (cartão, cobra mensalmente)
  // "one_time"  = pagamento único (cartão ou Pix, 1 mês de acesso)
  billingType  String    @default("recurring") @map("billing_type")
  trialUntil    DateTime? @map("trial_until")
  startsAt      DateTime  @default(now()) @map("starts_at")
  expiresAt     DateTime? @map("expires_at")
  // 🔒 Cancelamento no fim do ciclo (cancel_at_period_end do Stripe).
  // true = usuário pediu cancelar, mas mantém acesso até expiresAt.
  // Quando o webhook customer.subscription.deleted chega, vira false + status 'cancelled'.
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status]) // consulta subscription ativa
  @@map("subscriptions")
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("stripe")
  externalId  String   @map("external_id") // ID do evento Stripe (evt_...)
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, externalId]) // idempotência
  @@map("payment_webhook_events")
}

model WhatsappSession {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  name                String
  phone               String?
  /// Nome do perfil do WhatsApp conectado (vindo do webhook CONNECTION_UPDATE
  /// ou do fallback fetchInstance). Exibido na UI ao lado do número quando existe.
  profileName         String?   @map("profile_name")
  sessionName         String    @map("session_name")
  evolutionInstanceId String?   @map("evolution_instance_id")
  status              String    @default("disconnected")
  /// 🔒 S24 — Status intermediário antes de tentar conectar na Evolution.
  /// Criado quando o usuário tenta criar uma sessão sem bot publicado (ou
  /// config inválida). Fica esperando o owner ajustar — o botão Conectar
  /// /QR fica desabilitado até a config ficar válida.
  /// Valores: 'disconnected' | 'connecting' | 'connected' | 'draft' | 'error' | 'logged_out' | 'qr_expired'
  //
  /// 🔒 S25 — 'qr_expired' é o estado onde a sessão atingiu o limite de
  /// tentativas de QR sem scan (configurável em EVOLUTION_QR_MAX_ATTEMPTS,
  /// default 5). Neste estado o backend NÃO gera mais QR e o frontend
  /// mostra um botão Reconectar. O tenant pode reativar chamando
  /// POST /:id/reconnect ou /:id/connect, que zera qrAttempts.
  // 🔒 Não armazenamos QR Code nem credenciais do WhatsApp no banco — esses
  // dados ficam no armazenamento persistente da própria Evolution API
  // (volume Docker /evolution_data). O backend consulta /instance/connect
  // para obter o QR atual sob demanda no endpoint GET /sessions/:id/qr.
  // webhookSecretHash guarda o hash argon2 do secret gerado por sessão.
  // Esse secret é enviado à Evolution como header customizado (headers)
  // no webhook e usado para validar que o webhook recebido veio dela.
  webhookSecretHash   String?   @map("webhook_secret_hash")
  /// 🔒 S25 — Contador de QR Codes gerados sem scan. Cada poll de
  /// getQrCode que devolve um QR novo incrementa. Zerado quando a
  /// sessão conecta (CONNECTION_UPDATE state=open) ou quando o
  /// usuário pede /connect ou /reconnect. Se atinge
  /// EVOLUTION_QR_MAX_ATTEMPTS (default 5), status vira 'qr_expired'.
  qrAttempts          Int      @default(0) @map("qr_attempts")
  /// 🔒 S25 — Data do último QR gerado. Usada para debouncing de
  /// polling: se dois polls chegam dentro de EVOLUTION_QR_DEBOUNCE_MS
  /// (default 3000ms), servimos o QR anterior sem chamar a Evolution
  /// de novo. Isso evita spam de /instance/connect durante o polling.
  qrLastGeneratedAt  DateTime? @map("qr_last_generated_at")
  lastSeen            DateTime? @map("last_seen")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings      SessionSettings?
  conversations Conversation[]
  events        SessionEvent[]
  contactList   SessionContactListItem[]

  @@unique([sessionName]) // DB-8: lookup por Evolution webhook
  @@index([tenantId, status]) // DB-8: listagem por status
  @@map("whatsapp_sessions")
}

/// 🔒 S23 — Log de eventos de CONEXÃO por sessão (substitui o uso indevido do
/// inbox de mensagens como "log temporário"). Cada evento é uma transição de
/// estado observada pelo backend (webhook CONNECTION_UPDATE/QRCODE_UPDATED,
/// job de connect, logout manual) e é exibido na aba "Logs de conexão" da
/// página de detalhes da sessão.
model SessionEvent {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  tenantId  String   @map("tenant_id")
  /// Tipo do evento: created | qrcode_pending | connected | disconnected | error | logout | deleted
  type      String
  /// Código HTTP/WhatsApp de disconnect (401=conflict, 408=timeout, 440=gone).
  statusCode Int?    @map("status_code")
  /// Número conectado no momento do evento (vindo do webhook Evolution).
  phone     String?
  /// Mensagem legível para humanos (motivo do disconnect, etc.).
  message   String?
  /// Payload cru da Evolution para debug — guardamos só os campos relevantes.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)]) // S23: listagem por sessão, ordem desc
  @@index([tenantId, createdAt(sort: Desc)]) // S23: listagem por tenant
  @@index([type]) // S23: filtro por tipo
  @@map("session_events")
}

model SessionSettings {
  id         String  @id @default(uuid())
  sessionId  String  @unique @map("session_id")
  webhookUrl String? @map("webhook_url")
  

  // 🔒 S24 — Modo de filtragem de contatos via whitelist.
  // Valores: 'none' | 'whitelist'.
  //
  // 🔒 S24-b — `'blacklist'` deixou de ser um modo. A blacklist é uma
  // lista independente (estilo banimento) que SEMPRE bloqueia — independente
  // do modo aqui definido. Regras aplicadas no onMessagesUpsert antes da
  // persistência:
  //  - 'whitelist' + lista NÃO-vazia: só responde quem está na whitelist
  //    (e não está na blacklist).
  //  - 'whitelist' + lista vazia: whitelist não restringe; cai pra só-blacklist.
  //  - 'none': blacklist bloqueia quem está nela; resto passa.
  //  - contato na whitelist E blacklist ao mesmo tempo: prevalece o bloqueio
  //    (blacklist sempre vence — trava de segurança).
  contactFilterMode String @default("none") @map("contact_filter_mode")

  // 🔒 S24 — Bot ativo desta sessão. Obrigatório para a sessão ser
  // "conectável" (caso contrário status vira 'draft' e o QR fica
  // desabilitado na UI). SetNull pra não bloquear exclusão de bot.
  activeBotId         String?  @map("active_bot_id")
  activeBotVersionId  String?  @map("active_bot_version_id")

  session         WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activeBot       Bot?            @relation(fields: [activeBotId], references: [id], onDelete: SetNull)
  activeBotVersion BotVersion?    @relation(fields: [activeBotVersionId], references: [id], onDelete: SetNull)

  @@map("session_settings")
}

/// 🔒 S24 — Lista de contatos da sessão (whitelist e/ou blacklist).
/// Whitelist e blacklist podem coexistir na mesma sessão — o contato pode
/// estar nas duas listas (a regra de negócio decide a precedência).
/// Não usamos tag separada: a tabela é simples e indexada para lookup
/// rápido no inbound webhook (sessionId, contactId).
model SessionContactListItem {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  contactId String   @map("contact_id")
  /// Lista à qual o contato pertence: 'whitelist' | 'blacklist'.
  /// Mesmo contato pode aparecer duas vezes (uma por lista) — o
  /// @@unique cobre apenas o par (sessionId, contactId, list).
  list      String
  /// Motivo/observação opcional que o owner preenche ("cliente VIP",
  /// "concorrente", "só teste", etc.) — exibido na UI pra ajudar a
  /// lembrar por que adicionou.
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  session WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sessionId, contactId, list]) // não duplicar (contato, lista) na sessão
  @@index([sessionId])                   // S24: lookup "está na lista?" no inbound
  @@index([sessionId, list])             // S24: listagem por lista na UI
  @@map("session_contact_list_items")
}

model Bot {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  description    String?
  status         String   @default("draft")
  defaultVersion Int?     @map("default_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions        BotVersion[]
  sessionBindings SessionSettings[] // 🔒 S24 — sessões que apontam pra este bot como ativo

  @@index([tenantId, status]) // DB-1: bots ativos por tenant
  @@map("bots")
}

model BotVersion {
  id          String  @id @default(uuid())
  botId       String  @map("bot_id")
  version     Int
  description String?
  published   Boolean @default(false)

  bot       Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  rules     BotRule[]
  variables BotVariable[]
  sessionBindings SessionSettings[] // 🔒 S24 — sessões que apontam pra esta versão como ativa

  @@unique([botId, version])
  @@index([botId, published]) // DB-1: buscar versão publicada
  @@map("bot_versions")
}

model BotRule {
  id           String  @id @default(uuid())
  botVersionId String  @map("bot_version_id")
  priority     Int     @default(0)
  trigger      String
  responseType String  @map("response_type")
  nextRule     String? @map("next_rule")

  botVersion BotVersion @relation(fields: [botVersionId], references: [id], onDelete: Cascade)

  @@map("bot_rules")
}

model BotVariable {
  id           String  @id @default(uuid())
  botVersionId String  @map("bot_version_id")
  name         String
  type         String
  defaultValue String? @map("default_value")

  botVersion BotVersion @relation(fields: [botVersionId], references: [id], onDelete: Cascade)

  @@map("bot_variables")
}

model KnowledgeBase {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String  @id @default(uuid())
  knowledgeBaseId String  @map("knowledge_base_id")
  title           String
  fileId          String? @map("file_id")
  status          String  @default("processing")

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String @id @default(uuid())
  documentId String @map("document_id")
  chunkIndex Int    @map("chunk_index")
  content    String

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  phone     String
  name      String?
  email     String?
  avatar    String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tagRelations  ContactTagRelation[]
  listItems     SessionContactListItem[] // 🔒 S24 — em quais listas de sessão este contato aparece

  @@unique([tenantId, phone]) // lookup por phone dentro do tenant (upsert no webhook)
  @@index([phone]) // existente — mantido
  @@map("contacts")
}

model ContactTag {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  color    String?

  relations ContactTagRelation[]

  @@index([tenantId]) // DB-1: tags por tenant
  @@map("contact_tags")
}

model ContactTagRelation {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tag_relations")
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  contactId     String    @map("contact_id")
  sessionId     String    @map("session_id")
  assignedUser  String?   @map("assigned_user")
  status        String    @default("open")
  priority      String    @default("normal")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  session WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   User?           @relation("AssignedUser", fields: [assignedUser], references: [id])

  messages    Message[]
  assignments ConversationAssignment[]
  notes       ConversationNote[]

  @@index([lastMessageAt, contactId, sessionId]) // existente
  @@index([tenantId, lastMessageAt]) // DB-1: listagem paginada por tenant
  @@index([tenantId, status]) // DB-3: filtro por status
  @@index([tenantId, assignedUser]) // DB-3: conversas do agente
  @@index([contactId]) // DB-1: lookup por contato
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  externalId     String?  @map("external_id")
  direction      String
  type           String
  content        String?
  mediaUrl       String?  @map("media_url")
  status         String   @default("pending")
  timestamp      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId]) // DB-2: idempotência Evolution retry
  @@index([conversationId, timestamp, status]) // existente
  @@index([conversationId, timestamp]) // DB-2: paginação 50 últimas
  @@map("messages")
}

model ConversationAssignment {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  releasedAt     DateTime? @map("released_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId]) // DB-1: lookup por conversa
  @@index([userId]) // DB-1: histórico de atribuições do user
  @@map("conversation_assignments")
}

model ConversationNote {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId]) // DB-1: notas por conversa
  @@map("conversation_notes")
}

model FileAsset {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  storage   String
  path      String
  filename  String
  mime      String
  size      Int
  checksum  String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt]) // DB-1: listar arquivos por tenant
  @@map("files")
}

model Webhook {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  name     String
  url      String
  secret   String
  events   String[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId]) // DB-1: listagem por tenant
  @@map("webhooks")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  keyHash     String    @map("key_hash")
  prefix      String
  permissions String[]
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([prefix])
  @@map("api_keys")
}

model Job {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  type        String
  status      String    @default("pending")
  payload     Json
  attempts    Int       @default(0)
  scheduledAt DateTime? @map("scheduled_at")
  finishedAt  DateTime? @map("finished_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@map("jobs")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull) // DB-12: SetNull em vez de Restrict

  @@index([tenantId, createdAt]) // DB-6: consulta "últimos logs" por tenant
  @@map("audit_logs")
}

model DailyMetric {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  date                DateTime
  messagesIn          Int      @default(0) @map("messages_in")
  messagesOut         Int      @default(0) @map("messages_out")
  newContacts         Int      @default(0) @map("new_contacts")
  activeConversations Int      @default(0) @map("active_conversations")
  humanAttendances    Int      @default(0) @map("human_attendances")
  aiRequests          Int      @default(0) @map("ai_requests")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("daily_metrics")
}

/// 🔒 Convite enviado para um email que ainda não tem conta.
/// Quando o usuário se cadastra e verifica o email, o sistema detecta
/// invitações pendentes para aquele email, cria o TenantUser com a role
/// escolhida e marca a invite como `accepted`. Assim o usuário entra
/// direto na org sem precisar criar tenant próprio.
model Invitation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  roleName  String   @map("role_name") // owner | admin | agent
  status    String   @default("pending") // pending | accepted | cancelled
  invitedBy String   @map("invited_by") // userId de quem enviou
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([email, status]) // lookup por email ao verificar
  @@map("invitations")
}
